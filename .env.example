# Copia a .env y ajusta. docker compose lo carga automáticamente.
# Todo valor comentado usa el default que se muestra. Referencia completa:
# docs/configuracion-web.md

# --- Red ------------------------------------------------------------------
# Dirección host:puerto donde se publica la web (para el proxy inverso).
# WEB_BIND=127.0.0.1:8000

# --- Secretos y rutas -------------------------------------------------------
# Obligatorio. Genera con: openssl rand -hex 32
APP_SECRET_KEY=
# DATA_DIR=/data
# BACKENDS_CONFIG=/config/backends.toml
# JPLAG_JAR=/opt/jplag/jplag.jar

# --- Límites de subida y archivo -----------------------------------------
# MAX_UPLOAD_MB=50
# MAX_UNZIPPED_MB=300
# MAX_ZIP_ENTRIES=20000
# MAX_COMPRESSION_RATIO=100
# MAX_USERS=400
# MAX_PROBLEMS=40
# MAX_SUBMISSION_BYTES=1000000

# --- Rate limit, cupos y planificación ----------------------------------
# RATE_LIMIT_PER_HOUR=5
# MAX_JOBS_PER_USER=2
# MAX_CONCURRENT_JOBS=2
# JOB_TIMEOUT_S=1800
# JPLAG_PER_INVOCATION_TIMEOUT_S=300
# RETENTION_H=12
# CLEANUP_EVERY_MIN=30
# AWAITING_UPLOAD_TIMEOUT_S=3600

# --- Auth ----------------------------------------------------------------
# LOGIN_MAX_ATTEMPTS=8

# --- Juez LLM ----------------------------------------------------------
# LLM_MAX_SUBMISSIONS_PER_JOB=200
# LLM_MAX_CALLS_PER_DAY=2000
# LLM_MAX_TOKENS_PER_CALL=1500
# LLM_REQUEST_TIMEOUT_S=120
# LLM_THRESHOLD=70
# LLM_CONCURRENCY=2
# LLM_JUDGE_TOTAL_TIMEOUT_S=1800

# --- API keys de proveedores (habilitan su backend en backends.toml) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
